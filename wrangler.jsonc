{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxyy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "99e435a1-3396-4c78-9444-e9adbaacc5c7","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8f44185eefd44af0b571e522c881a8a7" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
